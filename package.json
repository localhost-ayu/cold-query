{
  "name": "cold-query",
  "version": "0.1.0",
  "private": true,
  "description": "SQL detective game that runs entirely in the browser, inside the fictional TraceOS.",
  "author": "Nathã Grazzioli Botelho",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/localhost-ayu/cold-query.git"
  },
  "scripts": {
    "predev": "node scripts/copy-sqlite.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-sqlite.mjs",
    "build": "next build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src docs scripts README.md CREDITS.md package.json tsconfig.json next.config.ts eslint.config.mjs vitest.config.ts vitest.setup.ts postcss.config.mjs",
    "format:check": "prettier --check src docs scripts README.md CREDITS.md package.json tsconfig.json next.config.ts eslint.config.mjs vitest.config.ts vitest.setup.ts postcss.config.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@phosphor-icons/react": "2.1.10",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "@tanstack/react-virtual": "3.14.21",
    "framer-motion": "13.4.6",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.7",
    "jsdom": "27.1.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.0.7"
  }
}
